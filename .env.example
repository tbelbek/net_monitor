# Network Monitor Email Configuration
# Copy this file to .env and fill in your email settings

# SMTP Server Configuration
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true

# Email Authentication
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Email Recipients (comma-separated)
EMAIL_TO=admin@example.com,security@example.com

# Optional: Excluded IPs (comma-separated)
# EXCLUDE_IP=192.168.1.1,10.0.0.1
